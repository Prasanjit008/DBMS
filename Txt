-- Q12
SELECT ENAME, SAL + COMM AS TOTAL
FROM EMP;

-- Q13
SELECT ENAME,
       SAL + COALESCE(NULLIF(COMM, 0), 100) AS TOTAL
FROM EMP;

-- Q14
SELECT ENAME,
       (SAL + COALESCE(COMM, 0)) * 12 AS ANNUAL_REMUNERATION
FROM EMP;

-- Q15
SELECT * FROM EMP
WHERE SAL > 2000
AND JOB = 'MANAGER';

-- Q16
SELECT * FROM EMP
WHERE SAL > 3000
OR JOB = 'MANAGER';

-- Q17
SELECT * FROM EMP
WHERE DEPTNO = 20
AND NOT SAL > 2000;

-- Q18
SELECT * FROM EMP
WHERE SAL > 2000
AND JOB IN ('MANAGER', 'CLERK');

-- Q19
SELECT * FROM EMP
WHERE ENAME LIKE 'WARD'
   OR ENAME LIKE 'FORD';

-- Q20
